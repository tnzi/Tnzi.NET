# http://editorconfig.org
root = true

[*]
#缩进风格：空格
indent_style = space
#缩进大小2
indent_size = 4
#换行符lf
end_of_line = lf
#字符集utf-8
charset = utf-8
#是否删除行尾的空格
trim_trailing_whitespace = true
#是否在文件的最后插入一个空行
insert_final_newline = true

[*.{xaml,json,csproj,cshtml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# ─────────────────────────────────────────────────────────────────────────────
# C# 编译期约定门禁（配合 Directory.Build.props 的 EnableNETAnalyzers +
# EnforceCodeStyleInBuild）。当前为 warnings-first：先让规则可见、积累存量清理，
# 待清零后再在此把少数高价值规则提级为 error 并开启 TreatWarningsAsErrors。
#
# 注意：框架特有的 7 条 "Never Violate"（[Route] 不含 api/ 前缀、框架程序集禁用
# IScopedDependency 自动注册、实体配置用 EntityTypeConfigurationBase、禁硬编码 DB SQL、
# 构造参数用 Check.NotNull、Admin 控制器继承 ApiAdminControllerBase、用 MapTo 而非 .Adapt）
# 属语义级规则，内置分析器无法覆盖，需后续自定义 Roslyn 分析器（Tnzi.Analyzers，待办）。
# ─────────────────────────────────────────────────────────────────────────────
[*.cs]
# 高价值：移除冗余 using（直接呼应"用 GlobalUsings、类文件不保留 redundant using"约定）
# ⚠ 这一条只有在生成 XML 文档时才会在 build 阶段报出（dotnet/roslyn#41640）。GenerateDocumentationFile
#   因此必须为 true——注意它有**两处**：根 Directory.Build.props 与 build/public.props，后者经
#   src/Directory.Build.props 在根之后导入，是 src/ 下的最终值。任一处改回 false，本规则都会
#   **静默失效**（IDE 里仍提示，构建输出里一条都不出）——2026-07-31 全仓一次性清理出的数百条存量，
#   正是 public.props 长期写着 false 积压出来的。
dotnet_diagnostic.IDE0005.severity = warning
# 高价值：未使用的私有成员 / 只写不读的私有字段。
# 二者合起来盯的是同一类东西——**看起来接上了、其实没有的依赖**。典型形态不是"写了个没人调的方法"，
# 而是提取类重构之后原类留着的那份注入：字段还在、Check.NotNull 还在、构造签名还在，
# 读起来完全像是这个类在用它。2026-09-01 全仓一次性清出 18 处，其中 6 处正是这种遗留
# （CheckService 的 protector/vendor/issuer、BankFeedService 的 providers、RagRetriever 的
# docRepository），它们真正的使用者早就搬到各自的协作者里去了。
# ⚠ 这两条报出来时**先判类型再动手**：可能是遗留（删），也可能是"能力接了一半"（要接上去，
# 删掉反而抹掉证据）。判据是去找那个能力现在有没有别的落点。
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
# 降噪：库代码是否 ConfigureAwait 由框架约定决定，不在此强制
dotnet_diagnostic.CA2007.severity = none
# 建议级（IDE 提示，不进构建警告）
dotnet_diagnostic.CA2016.severity = suggestion
dotnet_diagnostic.CA1822.severity = suggestion

# C# 代码风格偏好
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false