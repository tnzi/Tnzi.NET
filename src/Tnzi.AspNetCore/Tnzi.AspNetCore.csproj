<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ASP.NET Core integration for Tnzi.NET framework, providing middleware, controllers, filters, routing conventions, CORS, security headers, and exception handling</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi\Tnzi.csproj" />
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.Logging\Tnzi.Logging.csproj" />
    <ProjectReference Include="..\Tnzi.Mapster\Tnzi.Mapster.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- PublicApiAnalyzers API 门禁（0.1.0 冻结基线）。未登记的公共 API => RS0016 error；
       删除死条目 => RS0017 error。RS0026/RS0027（可选参数重载设计建议）保持 warning。
       基线见同目录 PublicAPI.Shipped.txt；增删改 API 的登记工作流见 docs/coding-standards/public-api-governance.md。 -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0024;RS0025</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\WelcomePage.html" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Tnzi.AspNetCore.props" Pack="true" PackagePath="build/" />
    <None Include="build\Tnzi.AspNetCore.targets" Pack="true" PackagePath="build/" />
    <None Include="buildTransitive\Tnzi.AspNetCore.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive\Tnzi.AspNetCore.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
