<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ASP.NET Core integration for Tnzi.NET framework, providing middleware, controllers, filters, routing conventions, CORS, security headers, and exception handling</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi\Tnzi.csproj" />
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.Logging\Tnzi.Logging.csproj" />
    <ProjectReference Include="..\Tnzi.Mapster\Tnzi.Mapster.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\WelcomePage.html" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Tnzi.AspNetCore.props" Pack="true" PackagePath="build/" />
    <None Include="build\Tnzi.AspNetCore.targets" Pack="true" PackagePath="build/" />
    <None Include="buildTransitive\Tnzi.AspNetCore.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive\Tnzi.AspNetCore.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
