<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>General-purpose finance and accounting module for Tnzi.NET framework: chart of accounts, double-entry general ledger, journal posting pipeline, multi-currency, fiscal years, and financial reports</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Services/Internal 边界：纯工具/解析类为 internal，仅对本模块测试开放。
         经 DI 注入 public 服务构造函数的协作类（LedgerPostingEngine 等）受 CS0051
         与容器仅解析 public 构造函数的限制必须保持 public，其跨模块边界由
         Payroll.Tests 的 InternalBoundaryTests 约定测试强制。
         Tnzi.Finance.Documents（可选渲染子模块）的 PdfSharpCheckRenderer 复用 internal
         的 MicrLineComposer（不依赖 PdfSharp，故留核心），经此 friend 声明可见——
         同 Tnzi.Finance.Ai 复用核心公共契约的思路，只是 MICR 拼装是 internal 原语。 -->
    <InternalsVisibleTo Include="Tnzi.Finance.Tests, PublicKey=$(TnziPublicKey)" />
    <InternalsVisibleTo Include="Tnzi.Finance.Documents, PublicKey=$(TnziPublicKey)" />
    <InternalsVisibleTo Include="Tnzi.Finance.Banking, PublicKey=$(TnziPublicKey)" />
    <!-- Tnzi.Finance.Offers（报价单 / 采购订单）复用 internal 的 UnitOfWorkAbortException：
         转换成发票/账单草稿时，lambda 内已发生写入之后的失败必须 abort 而不是 return，
         那是本模块的铁律而不是要约模块自己的规矩，故信号类型留在核心。 -->
    <InternalsVisibleTo Include="Tnzi.Finance.Offers, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

</Project>
