<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Document primitives for the Tnzi.NET framework: Office-to-PDF conversion (LibreOffice), HTML-to-PDF and thumbnails through a local headless browser, PDF inspection with coordinate-bearing tag lookup (PdfPig), coordinate-based PDF stamping and flattening (PDFsharp), and page rasterisation of an existing PDF, scans and faxes included (PDFium). Optional module with no entities and no tables; load it to get the six primitives out of the box. Note that rasterisation carries native binaries: publish with a runtime identifier.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只依赖核心：本包是与业务无关的文档原语，不认识任何业务模块 -->
    <ProjectReference Include="..\Tnzi\Tnzi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      重量级 PDF 依赖收在本可选包内，核心与其它消费者不被传递拉入。
      版本与既有消费者保持一致：PdfSharp 同 Tnzi.Finance.Documents，PdfPig 同 Tnzi.AI.Rag / Tnzi.Finance.Ai。

      PdfSharp 授权铁律：6.2.4 是最后一个 MIT 版本。6.5.0 起 nuspec 改为 AGPL-3.0-only，并带运行时授权校验
      （未注册授权时 new PdfDocument() / PdfReader 直接抛 PdfSharpLicenseException）。本框架为 MIT、被商业应用
      消费，不能把 AGPL 或一份付费授权强加给所有下游，所以锁在 6.2.4。改用别的 PDF 库或取得可覆盖下游的授权之前不要升。
    -->
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- 安全提升 System.Security.Cryptography.Pkcs：PdfSharp 对所有目标框架都只声明 >= 8.0.1，
         而 8.0.1 在 GHSA-2fmv-rv2c-59x7 / GHSA-846f-f764-76mx 的受影响范围内（修复版 10.0.13）。
         本包不依赖 Tnzi.EFCore，拿不到那边的同一条提升，所以在这里单独钉。 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!--
      ★ 全仓唯一带**原生二进制**的文档依赖，代价要看清楚：
      PDFtoImage (MIT) 传递引入 PDFium (BSD-3-Clause) 与 SkiaSharp (MIT)，两者各自按 RID 提供原生库。
      指定 RID 发布约 19 MB（pdfium.dll 7 MB + libSkiaSharp.dll 12 MB），
      不指定 RID 的可移植发布会把二十来个 RID 全带上（上百 MB）。
      这笔账落在**每一个**引用本包的消费者身上，包括一行光栅化都不调的 Tnzi.Signing ——
      合并前它曾是独立包 Tnzi.Documents.Raster，正是为了避免这一点。
      下面那份随包发的 targets 至少把 89 MB/RID 的原生 pdb 剔掉。
    -->
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      CA1416：PDFtoImage 的 API 标注了 [SupportedOSPlatform]，而它列出的集合
      （Windows / Linux / macOS / iOS / Android / browser）已经覆盖了 ASP.NET Core 能跑的每一个平台，
      本包又不可能在编译期知道消费者的目标平台。真跑在没有原生库的 RID 上时，
      PdfiumPdfRasterizer 会把 DllNotFoundException 翻译成一条说得清楚的 PdfRasterizationException，
      而不是让它变成一个看不懂的类型初始化异常。
    -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 把「剔除 SkiaSharp 原生 pdb」这条规则随包发给消费者：它占了 Windows 每个 RID 89 MB，
         而它唯一的用途是调试进 Skia 的 C++ 内部。消费者可用 TnziKeepNativeSymbols=true 关掉。 -->
    <None Include="build\Tnzi.Documents.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <Import Project="build\Tnzi.Documents.targets" />

  <ItemGroup>
    <!-- 坐标换算/字体探测/soffice 定位/原生库探测都是 internal，测试须直达（src 下全部强命名同一 key，故须带 PublicKey）。 -->
    <InternalsVisibleTo Include="Tnzi.Documents.Tests, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

</Project>
