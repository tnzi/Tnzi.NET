<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>OpenID Connect provider sub-module for the Tnzi.NET identity module: lets an application act as the identity provider for other web applications (client registry, authorization code + PKCE, ID tokens, userinfo, discovery and JWKS, grant revocation), built on OpenIddict and wired onto the framework's existing users, sessions and permissions. Optional - an application that never signs other apps in does not load it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只引用服务端与 EF 存储：OpenIddict.AspNetCore 元包还会带进 Client / WebIntegration 一整套客户端栈。 -->
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.Identity\Tnzi.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tnzi.Identity.OpenIdConnect.Tests, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

</Project>
