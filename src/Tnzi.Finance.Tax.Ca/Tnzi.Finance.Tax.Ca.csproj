<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Canadian country pack for the Tnzi.NET finance module: maps posted GST/HST to the CRA GST34 return lines (101 / 105 / 108 / 109). Optional module - the framework never ships any one country's tax tables, so load this only if you file in Canada.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.Finance\Tnzi.Finance.csproj" />
  </ItemGroup>

</Project>
