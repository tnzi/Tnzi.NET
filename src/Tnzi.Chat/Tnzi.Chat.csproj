<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>In-app messaging and announcement module for Tnzi.NET framework with SignalR real-time delivery and read tracking</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 列宽常量（ChatFieldLimits）由实体配置与写入校验共用，测试要能对着它断言。 -->
    <InternalsVisibleTo Include="Tnzi.Chat.Tests, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.Identity\Tnzi.Identity.csproj" />
    <ProjectReference Include="..\Tnzi.Identity.Presence\Tnzi.Identity.Presence.csproj" />
    <ProjectReference Include="..\Tnzi.Mapster\Tnzi.Mapster.csproj" />
    <ProjectReference Include="..\Tnzi.SignalR\Tnzi.SignalR.csproj" />
  </ItemGroup>

</Project>

