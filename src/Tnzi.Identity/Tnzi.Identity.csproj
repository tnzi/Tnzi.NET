<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Identity and authentication module for Tnzi.NET framework with JWT, OAuth2, user management, and session support</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Twitter" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 启动期存量修复任务等纯内部协作类为 internal，仅对本模块的两个测试项目开放。 -->
    <InternalsVisibleTo Include="Tnzi.Identity.Tests, PublicKey=$(TnziPublicKey)" />
    <InternalsVisibleTo Include="Tnzi.Identity.IntegrationTests, PublicKey=$(TnziPublicKey)" />
    <!-- 组织子模块改的是同一张 User 表，须与父模块走同一道超管目标护栏（SuperAdminTargetGuard）。 -->
    <InternalsVisibleTo Include="Tnzi.Identity.Organization, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
    <ProjectReference Include="..\Tnzi.Imaging\Tnzi.Imaging.csproj" />
  </ItemGroup>

</Project>
