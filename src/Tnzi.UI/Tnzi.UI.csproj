<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- This is a frontend project, not a .NET assembly -->
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <EnableDefaultItems>false</EnableDefaultItems>

    <!-- Suppress NuGet pack and compiler warnings -->
    <NoWarn>$(NoWarn);NU5128;NU5111;CS2008</NoWarn>

    <!-- Project type guidance -->
    <ProjectType>Frontend</ProjectType>
    <ProjectGuid>$(MSBuildProjectDirectory)</ProjectGuid>
  </PropertyGroup>

  <!-- File visibility rules are inherited from root Directory.Build.props -->

  <!-- Build target: run pnpm build (optional, for CI/CD) -->
  <Target Name="PnpmBuild" BeforeTargets="Build" Condition=" '$(BuildFrontend)' == 'true' ">
    <Exec Command="pnpm install" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="pnpm build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- Clean target -->
  <Target Name="PnpmClean" BeforeTargets="Clean" Condition="Exists('$(MSBuildProjectDirectory)\node_modules')">
    <Exec Command="pnpm clean" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
