{
  "name": "@tnzi/ai",
  "version": "0.1.0",
  "description": "Tnzi AI components - chat, agent visualization, workflow builder, and admin panels for AI-powered applications.",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components/index.js"
    },
    "./composables": {
      "types": "./dist/composables.d.ts",
      "import": "./dist/composables/index.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed/index.js"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*/index.js"
    },
    "./locale/*": {
      "types": "./dist/locale/*.d.ts",
      "import": "./dist/locale/*/index.js"
    },
    "./style.css": {
      "import": "./dist/style.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@iconify/vue": "^4.3.0",
    "@radix-icons/vue": "^1.0.0",
    "@tnzi/core": "workspace:*",
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/core": "^1.43.0",
    "@vue-flow/minimap": "^1.5.0",
    "@vueuse/core": "^14.2.1",
    "@vueuse/motion": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "katex": "^0.16.0",
    "markdown-it": "^14.0.0",
    "reka-ui": "^2.8.2",
    "shiki": "^3.0.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.0",
    "@types/markdown-it": "^14.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "@tnzi/core": "workspace:*",
    "vue": ">=3.5.0"
  },
  "keywords": [
    "tnzi",
    "ai",
    "chat",
    "agent",
    "workflow",
    "vue",
    "components"
  ],
  "author": "Tnzi.NET",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnzi/tnzi.net"
  }
}
