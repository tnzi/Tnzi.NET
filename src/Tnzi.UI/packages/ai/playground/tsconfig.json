{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@tnzi/ai": ["../src"],
      "@tnzi/ai/*": ["../src/*"],
      "@tnzi/core": ["../../core/src"],
      "@tnzi/core/*": ["../../core/src/*"]
    },
    "isolatedModules": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
