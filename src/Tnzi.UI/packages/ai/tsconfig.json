{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tnzi/core": ["../core/src"],
      "@tnzi/core/*": ["../core/src/*"]
    },
    "isolatedModules": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*", "../core/src/**/*"],
  "exclude": ["node_modules", "dist", "playground"]
}
