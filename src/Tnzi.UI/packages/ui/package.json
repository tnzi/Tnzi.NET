{
  "name": "@tnzi/ui",
  "version": "0.2.4",
  "description": "Tnzi UI common layer: theme context and tokens, the login stack, overlay primitives and library-neutral components. Renders with no component library.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js"
    },
    "./resolvers": {
      "types": "./dist/resolvers/index.d.ts",
      "import": "./dist/resolvers.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./theme/presets/*": {
      "import": "./src/theme/presets/*.json"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/plugin.js",
    "./src/plugin.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "vite.mjs",
    "vite.d.ts",
    "src/theme/presets",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@iconify/utils": "catalog:",
    "@tnzi/core": "workspace:*",
    "@vueuse/core": "catalog:",
    "colord": "^2.10.0"
  },
  "devDependencies": {
    "@iconify/vue": "catalog:",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.3",
    "pinia": "catalog:",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "catalog:",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "@iconify/vue": ">=5.0.0",
    "pinia": "^3.0.0 || ^4.0.0",
    "unocss": ">=66.0.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    },
    "unocss": {
      "optional": true
    }
  },
  "keywords": [
    "tnzi",
    "vue",
    "components",
    "ui"
  ],
  "author": "Tnzi.NET",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnzi/tnzi.net"
  }
}
