{
  "name": "@tnzi/ui",
  "version": "0.2.4",
  "description": "Tnzi UI components based on Naive UI.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js"
    },
    "./resolvers": {
      "types": "./dist/resolvers/index.d.ts",
      "import": "./dist/resolvers.js"
    },
    "./theme/presets/*": {
      "import": "./src/theme/presets/*.json"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/plugin.js",
    "./src/plugin.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src/theme/presets",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tnzi/core": "workspace:*",
    "@vue/reactivity": "^3.5.0",
    "@vueuse/core": "^11.0.0",
    "colord": "^2.9.3",
    "naive-ui": "^2.40.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "echarts": "^5.5.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.9.3",
    "unocss": "^66.6.8",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^3.0.0",
    "vue-draggable-plus": "^0.6.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "@iconify/vue": ">=5.0.0",
    "echarts": "^5.5.0",
    "vue": ">=3.5.0",
    "vue-draggable-plus": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "vue-draggable-plus": {
      "optional": true
    }
  },
  "keywords": [
    "tnzi",
    "naive-ui",
    "vue",
    "admin",
    "dashboard",
    "components",
    "ui"
  ],
  "author": "Tnzi.NET",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnzi/tnzi.net"
  }
}
