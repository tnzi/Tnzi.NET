{
  "name": "@tnzi/ui",
  "version": "0.2.4",
  "description": "Tnzi UI components based on Naive UI.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js"
    },
    "./resolvers": {
      "types": "./dist/resolvers/index.d.ts",
      "import": "./dist/resolvers.js"
    },
    "./theme/presets/*": {
      "import": "./src/theme/presets/*.json"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/plugin.js",
    "./src/plugin.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "vite.mjs",
    "vite.d.ts",
    "src/theme/presets",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tnzi/core": "workspace:*",
    "@vueuse/core": "catalog:",
    "colord": "^2.9.3",
    "cropperjs": "^2.1.1"
  },
  "devDependencies": {
    "@iconify/vue": "catalog:",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "echarts": "catalog:",
    "happy-dom": "^20.10.6",
    "naive-ui": "catalog:",
    "pinia": "catalog:",
    "typescript": "^6.0.3",
    "unocss": "^66.7.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.9",
    "vue": "catalog:",
    "vue-draggable-plus": "^0.6.1",
    "vue-tsc": "^3.3.5"
  },
  "peerDependencies": {
    "@iconify/vue": ">=5.0.0",
    "echarts": "^6.1.0",
    "naive-ui": "^2.40.0",
    "pinia": "^3.0.0",
    "vue": ">=3.5.0",
    "vue-draggable-plus": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "vue-draggable-plus": {
      "optional": true
    }
  },
  "keywords": [
    "tnzi",
    "naive-ui",
    "vue",
    "admin",
    "dashboard",
    "components",
    "ui"
  ],
  "author": "Tnzi.NET",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnzi/tnzi.net"
  }
}
