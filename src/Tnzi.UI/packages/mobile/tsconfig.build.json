{
  // Declaration-emit config for `vue-tsc --emitDeclarationOnly` (run after the
  // vite JS/CSS build). vue-tsc emits per-SFC `.vue.d.ts` + the barrels, which
  // vite-plugin-dts (4.x/5.x + vue-tsc 3) fails to do here.
  //
  // `paths: {}` clears `@tnzi/core` → ../core/src so the emit program stays
  // within this package's `src/**`; `@tnzi/core` resolves to its node_modules
  // dist `.d.ts`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {},
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/__tests__/**"]
}
