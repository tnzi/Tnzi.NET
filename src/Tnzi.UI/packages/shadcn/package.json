{
  "name": "@tnzi/shadcn",
  "version": "0.1.0",
  "description": "Tnzi UI components based on shadcn-vue. Ideal for external-facing sites and modern web apps.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components/index.js"
    },
    "./stores": {
      "types": "./dist/stores.d.ts",
      "import": "./dist/stores/index.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*/index.js"
    },
    "./resolvers": {
      "types": "./dist/resolvers.d.ts",
      "import": "./dist/resolvers/index.js"
    },
    "./style.css": {
      "import": "./dist/style.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@internationalized/date": "^3.11.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tnzi/core": "workspace:*",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^0.564.0",
    "pinia": "^2.2.0",
    "reka-ui": "^2.8.0",
    "shadcn-vue": "^0.9.0",
    "tailwind-merge": "^2.5.0",
    "v-dialogs": "^3.1.1",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.0",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "keywords": [
    "tnzi",
    "shadcn",
    "vue",
    "components",
    "ui"
  ],
  "author": "Tnzi.NET",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnzi/tnzi.net"
  }
}
