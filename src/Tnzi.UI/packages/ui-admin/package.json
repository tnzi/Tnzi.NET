{
  "name": "@tnzi/ui-admin",
  "version": "0.2.70",
  "description": "Tnzi admin panel UI components and pages, built on @tnzi/ui and @tnzi/core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "import": "./dist/pages.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "import": "./dist/locales/en.js"
    },
    "./locales/zh-cn": {
      "types": "./dist/locales/zh-cn.d.ts",
      "import": "./dist/locales/zh-cn.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@iconify/vue": "catalog:",
    "@vueuse/core": "catalog:",
    "echarts": "catalog:",
    "pinia-plugin-persistedstate": "^4.7.1"
  },
  "peerDependencies": {
    "@tnzi/core": "workspace:^",
    "@tnzi/ui": "workspace:^",
    "@tnzi/ui-ai": "workspace:^",
    "naive-ui": "^2.45.0",
    "pinia": "^3.0.0 || ^4.0.0",
    "vue": "^3.5.0",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@tnzi/ui-ai": {
      "optional": true
    },
    "vue-draggable-plus": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tnzi/core": "workspace:*",
    "@tnzi/ui": "workspace:*",
    "@tnzi/ui-ai": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "naive-ui": "catalog:",
    "pinia": "catalog:",
    "typescript": "^6.0.3",
    "unocss": "^66.8.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue": "catalog:",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "catalog:",
    "vue-tsc": "^3.3.10"
  },
  "keywords": [
    "tnzi",
    "admin",
    "vue",
    "components",
    "ui"
  ],
  "author": "Tnzi.NET",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnzi/tnzi.net"
  }
}
