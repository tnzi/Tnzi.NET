{
  // Declaration-emit config for `vue-tsc --emitDeclarationOnly` (run after the
  // vite JS/CSS build). vue-tsc natively emits per-SFC `.vue.d.ts` + the barrels,
  // which vite-plugin-dts (4.x/5.x + vue-tsc 3) fails to do here.
  //
  // `paths: {}` clears the dev mappings (`@tnzi/core` → ../core/src, etc.) so the
  // emit program contains only this package's `src/**` — declarations land in
  // `dist`, and `@tnzi/*` resolve to their node_modules dist `.d.ts`. (ui-admin
  // does not use the internal `@/` alias, so clearing all paths is safe.)
  "extends": "./tsconfig.json",
  // Tests must not reach the declaration program. `exclude` does not inherit
  // through `extends`, so leaving it off here is what put
  // `dist/components/pages/__tests__/TLoginPage.spec.d.ts` in the published
  // package. The other four packages carry this same list.
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/__tests__/**"],
  "compilerOptions": {
    "paths": {},
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src"
  }
}
