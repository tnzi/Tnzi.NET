{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*", "../ui/src/*"],
      "@tnzi/core": ["../core/src"],
      "@tnzi/core/*": ["../core/src/*"],
      "@tnzi/ui": ["../ui/src"],
      "@tnzi/ui/*": ["../ui/src/*"]
    },
    "isolatedModules": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/components/**/*",
    "src/headless/**/*",
    "src/services/**/*",
    "src/stores/**/*",
    "src/template/**/*",
    "src/router/**/*",
    "src/plugin/**/*",
    "src/locales/**/*",
    "src/styles/**/*",
    "src/index.ts",
    "src/shims-ui-ai.d.ts",
    "src/env.d.ts",
    "src/pages/index.ts",
    "src/pages/identity/UserManagement.vue",
    "src/pages/identity/user-config.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
