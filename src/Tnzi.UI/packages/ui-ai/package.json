{
  "name": "@tnzi/ui-ai",
  "version": "0.2.2",
  "description": "Tnzi AI components - chat, agent visualization, and workflow builder for AI-powered applications.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes.js"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale.js"
    },
    "./locale/*": {
      "types": "./dist/locale/*.d.ts",
      "import": "./dist/locale/*.js"
    },
    "./style.css": {
      "import": "./dist/style.css"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@tnzi/core": "workspace:*",
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/core": "^1.43.0",
    "@vue-flow/minimap": "^1.5.0",
    "katex": "^0.16.0",
    "markdown-it": "^14.0.0",
    "shiki": "^3.0.0"
  },
  "devDependencies": {
    "@tnzi/ui": "workspace:*",
    "@types/katex": "^0.16.0",
    "@types/markdown-it": "^14.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.3",
    "unocss": "^66.6.8",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "@tnzi/core": "workspace:*",
    "@tnzi/ui": "workspace:*",
    "naive-ui": ">=2.40.0",
    "vue": ">=3.5.0"
  },
  "keywords": [
    "tnzi",
    "ai",
    "chat",
    "agent",
    "workflow",
    "vue",
    "components"
  ],
  "author": "Tnzi.NET",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnzi/tnzi.net"
  }
}
