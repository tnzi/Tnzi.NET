{
  "name": "@tnzi/ui-ai",
  "version": "0.2.2",
  "description": "Tnzi AI components - chat, agent visualization, and workflow builder for AI-powered applications.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless.js"
    },
    "./chat": {
      "types": "./dist/chat-app.d.ts",
      "import": "./dist/chat.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./theme/*": {
      "types": "./dist/theme/*.d.ts",
      "import": "./dist/theme/*.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./style.css": {
      "import": "./dist/style.css"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/check-dts.mjs",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@iconify/vue": "catalog:",
    "@tnzi/core": "workspace:*",
    "@tnzi/ui": "workspace:*",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "unocss": "^66.7.2",
    "vite": "^7.3.5",
    "vue-tsc": "^3.3.5",
    "vue-router": "catalog:"
  },
  "peerDependencies": {
    "@iconify/vue": ">=5.0.0",
    "@tnzi/core": "workspace:^",
    "@tnzi/ui": "workspace:^",
    "naive-ui": ">=2.40.0",
    "vue": ">=3.5.0",
    "vue-router": ">=4.0.0"
  },
  "keywords": [
    "tnzi",
    "ai",
    "chat",
    "agent",
    "workflow",
    "vue",
    "components"
  ],
  "author": "Tnzi.NET",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tnzi/tnzi.net"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  }
}
