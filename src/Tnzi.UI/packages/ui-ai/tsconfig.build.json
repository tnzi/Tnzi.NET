{
  // Declaration-emit config for `vue-tsc --emitDeclarationOnly` (run after the
  // vite JS/CSS build). vue-tsc emits per-SFC `.vue.d.ts` + the barrels, which
  // vite-plugin-dts (4.x/5.x + vue-tsc 3) fails to do here.
  //
  // Cross-package `@tnzi/*` mappings are dropped (resolve from node_modules dist
  // `.d.ts` so the emit program stays within this package's `src/**`), but the
  // internal `@/` alias is kept since 22 SFCs import via `@/...`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "playground", "**/*.test.ts", "**/*.spec.ts", "**/__tests__/**"]
}
