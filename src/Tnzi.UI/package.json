{
  "name": "@tnzi/ui-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Tnzi.NET Frontend Packages Monorepo - core, ui, ui-admin, ai, mobile.",
  "scripts": {
    "build": "pnpm --filter @tnzi/core build && pnpm --filter @tnzi/ui build && pnpm --filter @tnzi/ui-admin build && pnpm --filter @tnzi/ui-ai build && pnpm --filter @tnzi/mobile build",
    "build:all": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "dev": "pnpm -r --parallel dev",
    "api:generics:check": "node ./tools/check-api-generics/check.mjs",
    "codegen": "tnzi generate --input ./openapi.json --out ./packages/core/src/services --targets dto,schema,api,metadata,paths",
    "codegen:url": "tnzi generate --url http://localhost:5000/swagger/v1/swagger.json --out ./packages/core/src/services --targets dto,schema,api,metadata,paths",
    "codegen:check": "tnzi generate --input ./openapi.json --out ./packages/core/src/services --targets dto,schema,api,metadata,paths --check",
    "preinstall": "npx only-allow pnpm",
    "version:check": "changeset status",
    "version:add": "changeset",
    "version:apply": "changeset version",
    "publish:dry": "pnpm build && pnpm -r publish --dry-run --no-git-checks",
    "publish:release": "pnpm build && changeset publish",
    "release": "node tools/release.mjs",
    "release:status": "node tools/release.mjs --status"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@vitejs/plugin-vue": "^5.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.0.0",
    "zod": "^3.24.0"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
