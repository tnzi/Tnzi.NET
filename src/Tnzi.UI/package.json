{
  "name": "@tnzi/ui-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Tnzi.NET Frontend Packages Monorepo - core, ui, ui-admin, ai, mobile.",
  "scripts": {
    "build": "pnpm --filter @tnzi/core build && pnpm --filter @tnzi/ui build && pnpm --filter @tnzi/ui-admin build && pnpm --filter @tnzi/ui-ai build && pnpm --filter @tnzi/mobile build",
    "build:all": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages/ui/src packages/ui-admin/src packages/ui-ai/src packages/core/src packages/mobile/src",
    "lint:fix": "eslint packages/ui/src packages/ui-admin/src packages/ui-ai/src packages/core/src packages/mobile/src --fix",
    "size": "pnpm -F @tnzi/ui exec size-limit && pnpm -F @tnzi/ui-admin exec size-limit && pnpm -F @tnzi/ui-ai exec size-limit",
    "clean": "pnpm -r clean",
    "dev": "pnpm -r --parallel dev",
    "api:generics:check": "node ./tools/check-api-generics/check.mjs",
    "codegen": "tnzi generate --input ./openapi.json --out ./packages/core/src/services --targets dto,schema,api,metadata,paths",
    "codegen:url": "tnzi generate --url http://localhost:5000/swagger/v1/swagger.json --out ./packages/core/src/services --targets dto,schema,api,metadata,paths",
    "codegen:check": "tnzi generate --input ./openapi.json --out ./packages/core/src/services --targets dto,schema,api,metadata,paths --check",
    "preinstall": "npx only-allow pnpm",
    "version:check": "changeset status",
    "version:add": "changeset",
    "version:apply": "changeset version",
    "publish:dry": "pnpm build && pnpm -r publish --dry-run --no-git-checks",
    "publish:release": "pnpm build && changeset publish",
    "release": "node tools/release.mjs",
    "release:status": "node tools/release.mjs --status",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "commit-msg": "cat \"$1\" | (cd src/Tnzi.UI && pnpm --silent exec commitlint)"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "rimraf": "^6.0.0",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^12.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^2.0.0",
    "zod": "^3.24.0"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
