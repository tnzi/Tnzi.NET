<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>File storage abstraction module for Tnzi.NET framework with local disk and in-memory providers. Object storage (Amazon S3, Cloudflare R2, Azure Blob) ships in the optional Tnzi.Storage.Cloud package, so neither AWSSDK.S3 nor Azure.Storage.Blobs is in this module's dependency closure.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Tnzi\Tnzi.csproj" />
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
  </ItemGroup>

  <!--
    Cronos 用于 CleanupOptions.CronExpression 的清理排程，属于本模块自身的能力。
    对象存储三家 SDK（AWSSDK.S3 / Azure.Storage.Blobs）不在这里：它们随 provider
    一起住在可选包 Tnzi.Storage.Cloud，本地磁盘存文件的部署不必背着它们的传递闭包。
  -->
  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tnzi.Imaging\Tnzi.Imaging.csproj" />
  </ItemGroup>

</Project>
