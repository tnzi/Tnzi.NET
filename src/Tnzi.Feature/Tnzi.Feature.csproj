<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>SaaS feature toggle module for Tnzi.NET framework with pluggable value providers and tenant/edition support</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 定义快照降级重试间隔等纯内部调节项为 internal，仅对本模块的测试项目开放。 -->
    <InternalsVisibleTo Include="Tnzi.Feature.Tests, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

</Project>
