<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Payment processing module for Tnzi.NET framework with Stripe and PayPal integration, order management, and webhook handling</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
    <ProjectReference Include="..\Tnzi.Notification\Tnzi.Notification.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Stripe.net" Version="47.0.0" />
    <PackageReference Include="PayPalCheckoutSdk" Version="1.0.4" />
  </ItemGroup>

</Project>
