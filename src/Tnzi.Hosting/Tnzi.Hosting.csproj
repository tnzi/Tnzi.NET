<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Pre-configured composite host module for Tnzi.NET framework bundling Identity, Authorization, Storage, Notification, and other enterprise features</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
    <ProjectReference Include="..\Tnzi.Hangfire\Tnzi.Hangfire.csproj" />
    <ProjectReference Include="..\Tnzi.AI\Tnzi.AI.csproj" />
    <ProjectReference Include="..\Tnzi.Audit\Tnzi.Audit.csproj" />
    <ProjectReference Include="..\Tnzi.Authorization\Tnzi.Authorization.csproj" />
    <ProjectReference Include="..\Tnzi.Feature\Tnzi.Feature.csproj" />
    <ProjectReference Include="..\Tnzi.Storage\Tnzi.Storage.csproj" />
    <ProjectReference Include="..\Tnzi.Identity\Tnzi.Identity.csproj" />
    <ProjectReference Include="..\Tnzi.Notification\Tnzi.Notification.csproj" />
    <ProjectReference Include="..\Tnzi.System\Tnzi.System.csproj" />
    <ProjectReference Include="..\Tnzi.Template\Tnzi.Template.csproj" />
    <ProjectReference Include="..\Tnzi.SignalR\Tnzi.SignalR.csproj" />
    <ProjectReference Include="..\Tnzi.Swagger\Tnzi.Swagger.csproj" />
    <ProjectReference Include="..\Tnzi.Localization\Tnzi.Localization.csproj" />
  </ItemGroup>

  <!-- 预制模板文件（作为内容文件复制到输出目录） -->
  <ItemGroup>
    <Content Include="Templates\**\*.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

