<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Smart composite host module for Tnzi.NET framework. Auto-adapts to loaded modules via OptionalDependsOn and activates [DefaultController] from each module.</Description>
  </PropertyGroup>

  <!--
    build\Tnzi.Hosting.props is a template: its TnziVersion default is the token __TNZI_VERSION__.
    TnziGenerateHostingProps substitutes $(PackageVersion) into a copy under obj\ and that copy is
    what gets packed, so the default always matches the Tnzi.Hosting package that imports it and
    every <TnziModules> package resolves to the same version as the core. The template itself is
    deliberately not packed (HostingTargetsSyncTests checks both halves; build/nuget-pack.ps1 and
    the publish workflow open the produced nupkg and check the substituted value).
  -->
  <PropertyGroup>
    <TnziHostingPropsTemplate>$(MSBuildProjectDirectory)\build\Tnzi.Hosting.props</TnziHostingPropsTemplate>
    <TnziHostingPropsGenerated>$(BaseIntermediateOutputPath)Tnzi.Hosting.props</TnziHostingPropsGenerated>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(TnziHostingPropsGenerated)" Pack="true" PackagePath="build\" Visible="false" />
    <None Include="build\Tnzi.Hosting.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Target Name="TnziGenerateHostingProps" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <Error Condition="'$(PackageVersion)' == ''"
           Text="PackageVersion is empty; the Tnzi.Hosting.props default TnziVersion cannot be generated." />
    <Error Condition="!Exists('$(TnziHostingPropsTemplate)')"
           Text="Template $(TnziHostingPropsTemplate) is missing." />
    <PropertyGroup>
      <_TnziHostingPropsContent>$([System.IO.File]::ReadAllText('$(TnziHostingPropsTemplate)').Replace('__TNZI_VERSION__', '$(PackageVersion)'))</_TnziHostingPropsContent>
    </PropertyGroup>
    <Error Condition="$(_TnziHostingPropsContent.Contains('__TNZI_VERSION__'))"
           Text="The __TNZI_VERSION__ token in $(TnziHostingPropsTemplate) was not substituted." />
    <WriteLinesToFile File="$(TnziHostingPropsGenerated)" Lines="$(_TnziHostingPropsContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Message Importance="high" Text="Tnzi.Hosting.props generated with TnziVersion default $(PackageVersion)" />
  </Target>

  <ItemGroup>
    <!-- 基线依赖 — 传递给 NuGet 消费者 -->
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
    <ProjectReference Include="..\Tnzi.Swagger\Tnzi.Swagger.csproj" />
    <ProjectReference Include="..\Tnzi.Localization\Tnzi.Localization.csproj" />

    <!-- 可选模块编译时引用（[OptionalDependsOn] + 事件处理器需要）— 不传递给 NuGet 消费者 -->
    <ProjectReference Include="..\Tnzi.Identity\Tnzi.Identity.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Identity.Presence\Tnzi.Identity.Presence.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Notification\Tnzi.Notification.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Notification.Push\Tnzi.Notification.Push.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Storage.Cloud\Tnzi.Storage.Cloud.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Payment.Stripe\Tnzi.Payment.Stripe.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Payment.PayPal\Tnzi.Payment.PayPal.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Storage.Workspace\Tnzi.Storage.Workspace.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Finance.Offers\Tnzi.Finance.Offers.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Authorization.DataAuth\Tnzi.Authorization.DataAuth.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Identity.Organization\Tnzi.Identity.Organization.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Payment.Billing\Tnzi.Payment.Billing.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Payment.Subscriptions\Tnzi.Payment.Subscriptions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Payment.Promotions\Tnzi.Payment.Promotions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.System\Tnzi.System.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Authorization\Tnzi.Authorization.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.Storage\Tnzi.Storage.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.AI\Tnzi.AI.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.AI.Skills\Tnzi.AI.Skills.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Tnzi.AI.Workflow\Tnzi.AI.Workflow.csproj" PrivateAssets="all" />
