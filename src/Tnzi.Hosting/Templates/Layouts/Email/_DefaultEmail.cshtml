---
description: Default email layout with modern design and full email client compatibility
isDefault: true
metadata:
  type: Email
  version: "3.0"
---
<!DOCTYPE html>
<html lang="zh-CN" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
    <title>@Model.Subject</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:AllowPNG/>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <style type="text/css">
        table { border-collapse: collapse; }
        td { font-family: Arial, sans-serif; }
    </style>
    <![endif]-->
    <style type="text/css">
        /* Reset */
        body, table, td, p, a, li { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; display: block; }
        
        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            background-color: #f8f9fa;
        }
        
        a[x-apple-data-detectors] {
            color: inherit !important;
            text-decoration: none !important;
        }
        
        @@media only screen and (max-width: 620px) {
            .wrapper { width: 100% !important; }
            .mobile-padding { padding-left: 24px !important; padding-right: 24px !important; }
            .mobile-padding-header { padding: 36px 24px !important; }
            .mobile-stack { display: block !important; width: 100% !important; }
            .mobile-center { text-align: center !important; }
            .mobile-button a { display: block !important; width: 100% !important; text-align: center !important; }
            .feature-cell { display: block !important; width: 100% !important; padding: 20px 0 !important; }
            .mobile-spacer { height: 20px !important; }
            .greeting { font-size: 22px !important; }
            .footer-links-cell { display: block !important; padding: 6px 0 !important; }
            .footer-divider { display: none !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa; width: 100% !important;">
    
    <!-- Preview Text -->
    @if (!string.IsNullOrEmpty(Model.PreviewText))
    {
        <div style="display: none; max-height: 0px; overflow: hidden; mso-hide: all;">
            @Model.PreviewText &zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
        </div>
    }
    
    <!-- Outer Wrapper -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f8f9fa;">
        <tr>
            <td align="center" style="padding: 40px 16px;">
                
                <!-- Email Container 600px -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" class="wrapper" style="max-width: 600px; width: 100%;">
                    <tr>
                        <td>
                            <!--[if !mso]><!-->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.06);">
                                <tr>
                                    <td>
                            <!--<![endif]-->
                            
                            <!-- Main Content Table -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #ffffff;">
                                
                                <!-- ========== HEADER with Gradient ========== -->
                                <tr>
                                    <td align="center" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
                                        <!--[if mso]>
                                        <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="width:600px;">
                                        <v:fill type="gradient" color="#0f3460" color2="#1a1a2e" angle="135"/>
                                        <v:textbox inset="0,0,0,0">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                        <tr>
                                        <td align="center" style="padding: 48px 40px;">
                                        <![endif]-->
                                        <!--[if !mso]><!-->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td align="center" class="mobile-padding-header" style="padding: 48px 40px;">
                                        <!--<![endif]-->
                                                    <!-- Logo -->
                                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                                        <tr>
                                                            <td align="center" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 28px; font-weight: 700; color: #ffffff; letter-spacing: -0.5px;">
                                                                @(Model.AppName ?? "Tnzi")<span style="display: inline-block; width: 8px; height: 8px; background-color: #e94560; border-radius: 50%; margin-left: 3px; vertical-align: super; font-size: 8px;">&#8203;</span>
                                                            </td>
                                                        </tr>
                                                        @if (!string.IsNullOrEmpty(Model.Tagline))
                                                        {
                                                            <tr>
                                                                <td align="center" style="padding-top: 10px; font-family: Arial, sans-serif; font-size: 12px; color: rgba(255,255,255,0.7); letter-spacing: 3px; text-transform: uppercase;">
                                                                    @Model.Tagline
                                                                </td>
                                                            </tr>
                                                        }
                                                    </table>
                                        <!--[if !mso]><!-->
                                                </td>
                                            </tr>
                                        </table>
                                        <!--<![endif]-->
                                        <!--[if mso]>
                                        </td>
                                        </tr>
                                        </table>
                                        </v:textbox>
                                        </v:rect>
                                        <![endif]-->
                                    </td>
                                </tr>
                                
                                <!-- ========== MAIN CONTENT ========== -->
                                <tr>
                                    <td class="mobile-padding" style="padding: 48px 48px 32px 48px; background-color: #ffffff;">
                                        @Html.Raw(Model.Content)
                                    </td>
                                </tr>
                                
                                <!-- ========== FOOTER ========== -->
                                <tr>
                                    <td style="background-color: #1a1a2e;">
                                        <!--[if mso]>
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" bgcolor="#1a1a2e">
                                        <tr>
                                        <td style="padding: 40px 48px;">
                                        <![endif]-->
                                        <!--[if !mso]><!-->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #1a1a2e;">
                                            <tr>
                                                <td class="mobile-padding" style="padding: 40px 48px;">
                                        <!--<![endif]-->
                                        
                                                    <!-- Company Info -->
                                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                                        <tr>
                                                            <td align="center" style="font-family: Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 13px; color: rgba(255,255,255,0.6); line-height: 1.8; padding-bottom: 20px;">
                                                                @(Model.CompanyName ?? Model.AppName ?? "Tnzi")<br>
                                                                @if (!string.IsNullOrEmpty(Model.Address))
                                                                {
                                                                    <text>@Model.Address<br></text>
                                                                }
                                                                @if (!string.IsNullOrEmpty(Model.Phone))
                                                                {
                                                                    <text>Tel: @Model.Phone</text>
                                                                }
                                                            </td>
                                                        </tr>
                                                    </table>
                                                    
                                                    <!-- Footer Links -->
                                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                                        <tr>
                                                            <td align="center" style="padding-bottom: 20px;">
                                                                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                                                    <tr>
                                                                        @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                                                                        {
                                                                            <td class="footer-links-cell" style="padding: 0 12px;">
                                                                                <a href="@Model.WebsiteUrl" style="font-family: Arial, sans-serif; font-size: 12px; color: rgba(255,255,255,0.6); text-decoration: none;">Website</a>
                                                                            </td>
                                                                            <td class="footer-divider" style="color: rgba(255,255,255,0.2);">|</td>
                                                                        }
                                                                        @if (!string.IsNullOrEmpty(Model.PrivacyUrl))
                                                                        {
                                                                            <td class="footer-links-cell" style="padding: 0 12px;">
                                                                                <a href="@Model.PrivacyUrl" style="font-family: Arial, sans-serif; font-size: 12px; color: rgba(255,255,255,0.6); text-decoration: none;">Privacy Policy</a>
                                                                            </td>
                                                                            <td class="footer-divider" style="color: rgba(255,255,255,0.2);">|</td>
                                                                        }
                                                                        @if (!string.IsNullOrEmpty(Model.HelpUrl))
                                                                        {
                                                                            <td class="footer-links-cell" style="padding: 0 12px;">
                                                                                <a href="@Model.HelpUrl" style="font-family: Arial, sans-serif; font-size: 12px; color: rgba(255,255,255,0.6); text-decoration: none;">Help Center</a>
                                                                            </td>
                                                                        }
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                    
                                                    <!-- Copyright & Unsubscribe -->
                                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                                        <tr>
                                                            <td align="center" style="font-family: Arial, sans-serif; font-size: 11px; color: rgba(255,255,255,0.4); line-height: 1.7;">
                                                                &copy; @DateTime.UtcNow.Year @(Model.AppName ?? "Tnzi"). All rights reserved.<br>
                                                                @if (!string.IsNullOrEmpty(Model.UnsubscribeUrl))
                                                                {
                                                                    <text>If you no longer wish to receive these emails, <a href="@Model.UnsubscribeUrl" style="color: #e94560; text-decoration: underline;">unsubscribe here</a></text>
                                                                }
                                                            </td>
                                                        </tr>
                                                    </table>
                                        
                                        <!--[if !mso]><!-->
                                                </td>
                                            </tr>
                                        </table>
                                        <!--<![endif]-->
                                        <!--[if mso]>
                                        </td>
                                        </tr>
                                        </table>
                                        <![endif]-->
                                    </td>
                                </tr>
                                
                            </table>
                            
                            <!--[if !mso]><!-->
                                    </td>
                                </tr>
                            </table>
                            <!--<![endif]-->
                            
                        </td>
                    </tr>
                </table>
                
            </td>
        </tr>
    </table>
    
</body>
</html>
