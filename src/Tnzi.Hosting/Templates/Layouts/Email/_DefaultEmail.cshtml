---
description: Default email layout with modern design and full email client compatibility
isDefault: true
metadata:
  type: Email
  version: "4.0"
---
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
    <!-- Declaring both schemes stops Outlook/Windows Mail from force-inverting the whole message -->
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title>@Model.Subject</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:AllowPNG/>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <style type="text/css">
        table { border-collapse: collapse; }
        td { font-family: Arial, sans-serif; }
    </style>
    <![endif]-->
    <style type="text/css">
        /* Reset */
        body, table, td, p, a, li { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; display: block; }

        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            background-color: #f4f5f7;
        }

        a[x-apple-data-detectors] {
            color: inherit !important;
            text-decoration: none !important;
        }

        @@media only screen and (max-width: 620px) {
            .wrapper { width: 100% !important; }
            .pad { padding-left: 24px !important; padding-right: 24px !important; }
            .greeting { font-size: 20px !important; }
            /* Full-width tap target on phones - the button is the whole point of the message */
            .btn { width: 100% !important; }
            .btn a { display: block !important; }
        }

        /* Clients that honour prefers-color-scheme (Apple Mail, iOS, Outlook 2019+, Thunderbird).
           Gmail ignores this and inverts on its own, which is why the palette stays high-contrast
           and gradient-free: an inverted flat colour still reads, an inverted gradient does not. */
        @@media (prefers-color-scheme: dark) {
            /* body itself carries an inline background - without this the area below the
               card stays light and the message shows a pale band under itself */
            body { background-color: #14161a !important; }
            .body-bg { background-color: #14161a !important; }
            .card { background-color: #1c1f24 !important; border-color: #2d323a !important; }
            .rule { background-color: #2d323a !important; }
            .ink { color: #e8eaed !important; }
            .ink-soft { color: #b6bcc4 !important; }
            .ink-faint { color: #8b929b !important; }
            .panel { background-color: #23272e !important; border-color: #343a43 !important; }
            /* The light-mode navy sits at 1.3:1 against the dark card - the button stops
               reading as a button. This blue clears 3:1 against the card (WCAG for UI
               components) while white label text still clears 4.5:1 against the button. */
            .btn td { background-color: #2563eb !important; }
            .btn a { background-color: #2563eb !important; }
            /* Quiet links (fallback URLs, footer) - the light-mode grey only reaches 3.3:1 here */
            .ink-faint a { color: #9aa4b2 !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f5f7; width: 100% !important;">

    <!-- Preview text -->
    @if (!string.IsNullOrEmpty(Model.PreviewText))
    {
        <div style="display: none; max-height: 0px; overflow: hidden; mso-hide: all;">
            @Model.PreviewText &zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
        </div>
    }

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" class="body-bg" style="background-color: #f4f5f7;">
        <tr>
            <td align="center" style="padding: 32px 16px;">

                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" class="wrapper card" style="max-width: 600px; width: 100%; background-color: #ffffff; border: 1px solid #e6e8eb; border-radius: 12px;">

                    <!-- Brand line: a quiet mark, not a banner. The body never repeats it. -->
                    <tr>
                        <td class="pad" style="padding: 26px 40px 0 40px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 15px; font-weight: 700; color: #1a1a2e; letter-spacing: 0.2px;" class="ink">
                                        @(Model.AppName ?? "Tnzi")<span style="display: inline-block; width: 5px; height: 5px; background-color: #e94560; border-radius: 50%; margin-left: 4px; vertical-align: baseline; font-size: 5px;">&#8203;</span>
                                    </td>
                                    @if (!string.IsNullOrEmpty(Model.Tagline))
                                    {
                                        <td style="padding-left: 10px; font-family: Arial, sans-serif; font-size: 11px; color: #8b929b; letter-spacing: 1.5px; text-transform: uppercase;" class="ink-faint">
                                            @Model.Tagline
                                        </td>
                                    }
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td class="pad" style="padding: 24px 40px 32px 40px;">
                            @Html.Raw(Model.Content)
                        </td>
                    </tr>

                    <!-- Hairline above the footer -->
                    <tr>
                        <td class="pad" style="padding: 0 40px;">
                            <div class="rule" style="height: 1px; background-color: #eaecef; font-size: 1px; line-height: 1px;">&nbsp;</div>
                        </td>
                    </tr>

                    <!-- Footer: two short lines. Optional rows render only when supplied,
                         so an app that passes nothing gets a genuinely compact footer. -->
                    <tr>
                        <td class="pad" style="padding: 18px 40px 22px 40px;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                @if (!string.IsNullOrEmpty(Model.WebsiteUrl) || !string.IsNullOrEmpty(Model.PrivacyUrl) || !string.IsNullOrEmpty(Model.HelpUrl))
                                {
                                    <tr>
                                        <td style="padding-bottom: 8px; font-family: Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #8b929b;" class="ink-faint">
                                            @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                                            {
                                                <a href="@Model.WebsiteUrl" style="color: #6b7280; text-decoration: none;">Website</a>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.HelpUrl))
                                            {
                                                <text>&nbsp;&middot;&nbsp;</text>
                                                <a href="@Model.HelpUrl" style="color: #6b7280; text-decoration: none;">Help</a>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.PrivacyUrl))
                                            {
                                                <text>&nbsp;&middot;&nbsp;</text>
                                                <a href="@Model.PrivacyUrl" style="color: #6b7280; text-decoration: none;">Privacy</a>
                                            }
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td style="font-family: Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #8b929b;" class="ink-faint">
                                        &copy; @DateTime.UtcNow.Year @(Model.CompanyName ?? Model.AppName ?? "Tnzi")@if (!string.IsNullOrEmpty(Model.Address)) { <text> &middot; @Model.Address</text> }@if (!string.IsNullOrEmpty(Model.Phone)) { <text> &middot; @Model.Phone</text> }
                                    </td>
                                </tr>
                                @if (!string.IsNullOrEmpty(Model.UnsubscribeUrl))
                                {
                                    <tr>
                                        <td style="padding-top: 6px; font-family: Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #8b929b;" class="ink-faint">
                                            <a href="@Model.UnsubscribeUrl" style="color: #6b7280; text-decoration: underline;">Unsubscribe</a>
                                        </td>
                                    </tr>
                                }
                            </table>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
