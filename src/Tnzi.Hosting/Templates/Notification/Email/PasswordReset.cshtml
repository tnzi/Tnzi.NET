---
subject: Password Reset Request - @Model.AppName
layout: DefaultEmail
description: Password reset email template
metadata:
  type: Email
  version: "3.0"
---
<!-- Greeting -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td class="greeting" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 24px; font-weight: 600; color: #1a1a2e; line-height: 1.3; padding-bottom: 24px;">
            Password Reset Request
        </td>
    </tr>
</table>

<!-- Body Text -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 16px; line-height: 1.7; color: #4a5568; padding-bottom: 20px;">
            Hi @(Model.UserName ?? "there"),
        </td>
    </tr>
    <tr>
        <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 16px; line-height: 1.7; color: #4a5568; padding-bottom: 20px;">
            We received a request to reset the password for your <strong style="color: #1a1a2e;">@(Model.AppName ?? "account")</strong>. If you made this request, click the button below to create a new password.
        </td>
    </tr>
</table>

<!-- Highlight Box -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 24px 0;">
    <tr>
        <td width="4" style="background-color: #dc2626;"></td>
        <td style="background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); padding: 24px 28px;">
            <!--[if mso]>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" bgcolor="#fef2f2">
            <tr>
            <td style="padding: 24px 28px;">
            <![endif]-->
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                    <td style="font-family: Arial, sans-serif; font-size: 12px; font-weight: bold; color: #dc2626; letter-spacing: 2px; text-transform: uppercase; padding-bottom: 12px;">
                        Reset Your Password
                    </td>
                </tr>
                <tr>
                    <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #2d3748;">
                        Click the button below to securely reset your password. You'll be asked to create a new password.
                    </td>
                </tr>
            </table>
            <!--[if mso]>
            </td>
            </tr>
            </table>
            <![endif]-->
        </td>
    </tr>
</table>

<!-- CTA Button -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 32px 0;">
    <tr>
        <td align="center">
            <!--[if mso]>
            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="@Model.ResetUrl" style="height:52px;v-text-anchor:middle;width:200px;" arcsize="50%" stroke="false">
            <v:fill type="gradient" color="#ef4444" color2="#dc2626" angle="135"/>
            <w:anchorlock/>
            <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">Reset Password</center>
            </v:roundrect>
            <![endif]-->
            <!--[if !mso]><!-->
            <a href="@Model.ResetUrl" target="_blank" style="display: inline-block; background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 16px; font-weight: 600; text-decoration: none; padding: 16px 40px; border-radius: 50px; letter-spacing: 0.5px; box-shadow: 0 4px 16px rgba(220,38,38,0.3);">Reset Password</a>
            <!--<![endif]-->
        </td>
    </tr>
</table>

<!-- Fallback Link -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td align="center" style="padding-top: 16px; font-family: Arial, sans-serif; font-size: 13px; color: #718096; line-height: 1.6;">
            If the button doesn't work, <a href="@Model.ResetUrl" style="color: #dc2626; text-decoration: underline;">click here to reset your password</a>
        </td>
    </tr>
</table>

<!-- Warning Box -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 24px 0;">
    <tr>
        <td width="4" style="background-color: #f59e0b;"></td>
        <td style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); padding: 20px 24px;">
            <!--[if mso]>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" bgcolor="#fef3c7">
            <tr>
            <td style="padding: 20px 24px;">
            <![endif]-->
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                    <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #92400e;">
                        <strong>Important:</strong> This link will expire in <strong>@(Model.ExpirationMinutes ?? 60) minutes</strong> for security reasons.
                    </td>
                </tr>
            </table>
            <!--[if mso]>
            </td>
            </tr>
            </table>
            <![endif]-->
        </td>
    </tr>
</table>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 32px 0;">
    <tr>
        <td style="height: 1px; background: linear-gradient(90deg, transparent 0%, #e2e8f0 50%, transparent 100%); font-size: 1px; line-height: 1px;">
            &nbsp;
        </td>
    </tr>
</table>

<!-- Security Tips -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f9fafb; border-radius: 12px; margin-bottom: 24px;">
    <tr>
        <td style="padding: 24px;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                    <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 14px; font-weight: 600; color: #1a1a2e; padding-bottom: 12px;">
                        Security Tips
                    </td>
                </tr>
                <tr>
                    <td style="font-family: Arial, sans-serif; font-size: 14px; color: #4a5568; line-height: 1.8;">
                        • Use a strong password with at least 8 characters<br>
                        • Include uppercase, lowercase, numbers, and symbols<br>
                        • Don't reuse passwords from other accounts<br>
                        • Never share your password with anyone
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<!-- Info Box -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 24px 0;">
    <tr>
        <td width="4" style="background-color: #6366f1;"></td>
        <td style="background: linear-gradient(135deg, #f8f9fa 0%, #eef1f5 100%); padding: 20px 24px;">
            <!--[if mso]>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" bgcolor="#f8f9fa">
            <tr>
            <td style="padding: 20px 24px;">
            <![endif]-->
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                    <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #4338ca;">
                        <strong>Didn't request this?</strong> If you didn't request a password reset, please ignore this email. Your password will remain unchanged and your account is secure.
                    </td>
                </tr>
            </table>
            <!--[if mso]>
            </td>
            </tr>
            </table>
            <![endif]-->
        </td>
    </tr>
</table>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 32px 0;">
    <tr>
        <td style="height: 1px; background: linear-gradient(90deg, transparent 0%, #e2e8f0 50%, transparent 100%); font-size: 1px; line-height: 1px;">
            &nbsp;
        </td>
    </tr>
</table>

<!-- Small Text -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td style="font-family: Arial, sans-serif; font-size: 12px; color: #999999; line-height: 1.6;">
            This is an automated security email. If you have concerns about your account security, please contact our support team immediately.
        </td>
    </tr>
</table>
