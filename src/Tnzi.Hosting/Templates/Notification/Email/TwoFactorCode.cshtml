---
subject: "Your verification code is @Model.Code"
layout: DefaultEmail
description: Two-factor authentication verification code email template
metadata:
  type: Email
  version: "5.0"
---
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td class="greeting ink" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 22px; font-weight: 600; color: #1a1a2e; line-height: 1.35; padding-bottom: 14px;">
            Verification code
        </td>
    </tr>
    <tr>
        <td class="ink-soft" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 16px; line-height: 1.65; color: #4a5568;">
            Hi @(Model.UserName ?? "there"), use this code to finish signing in.
        </td>
    </tr>
</table>

<!-- Code -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 22px 0 0 0;">
    <tr>
        <td class="panel" align="center" bgcolor="#f6f8fa" style="background-color: #f6f8fa; border: 1px solid #e1e4e8; border-radius: 10px; padding: 22px 16px;">
            <div class="ink" style="font-family: 'SF Mono', 'Consolas', 'Monaco', 'Courier New', monospace; font-size: 34px; font-weight: 700; letter-spacing: 9px; color: #1a1a2e; line-height: 1.2;">@Model.Code</div>
        </td>
    </tr>
</table>

<!-- Expiry + security -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 20px;">
    <tr>
        <td class="ink-soft" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #4a5568;">
            @if (Model.ExpirationMinutes != null)
            {
                <text>The code expires in @Model.ExpirationMinutes minutes. </text>
            }
            Never share it - nobody from our team will ask you for it.
        </td>
    </tr>
</table>

<!-- Reassurance -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 22px;">
    <tr>
        <td class="ink-faint" style="font-family: Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #8b929b;">
            Didn't try to sign in? Someone may know your password - change it now.
        </td>
    </tr>
</table>
