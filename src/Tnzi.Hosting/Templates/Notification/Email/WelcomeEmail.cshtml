---
subject: Welcome to @Model.AppName!
layout: DefaultEmail
description: Welcome email template for new user registration
metadata:
  type: Email
  version: "3.0"
---
<!-- Greeting -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td class="greeting" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 24px; font-weight: 600; color: #1a1a2e; line-height: 1.3; padding-bottom: 24px;">
            Welcome, @(Model.UserName ?? "there")!
        </td>
    </tr>
</table>

<!-- Body Text -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 16px; line-height: 1.7; color: #4a5568; padding-bottom: 20px;">
            Thank you for joining <strong style="color: #1a1a2e;">@(Model.AppName ?? "our platform")</strong>! We're thrilled to have you on board.
        </td>
    </tr>
    <tr>
        <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 16px; line-height: 1.7; color: #4a5568; padding-bottom: 20px;">
            Your account has been successfully created and you're now part of our community. We're committed to providing you with the best experience possible.
        </td>
    </tr>
</table>

@if (Model.RequireEmailConfirmation == true && !string.IsNullOrEmpty(Model.ConfirmationUrl))
{
    <!-- Highlight Box - Action Required -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 24px 0;">
        <tr>
            <td width="4" style="background-color: #e94560;"></td>
            <td style="background: linear-gradient(135deg, #f8f9fa 0%, #eef1f5 100%); padding: 24px 28px;">
                <!--[if mso]>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" bgcolor="#f8f9fa">
                <tr>
                <td style="padding: 24px 28px;">
                <![endif]-->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="font-family: Arial, sans-serif; font-size: 12px; font-weight: bold; color: #e94560; letter-spacing: 2px; text-transform: uppercase; padding-bottom: 12px;">
                            Action Required
                        </td>
                    </tr>
                    <tr>
                        <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #2d3748;">
                            Please verify your email address to activate your account and unlock all features.
                        </td>
                    </tr>
                </table>
                <!--[if mso]>
                </td>
                </tr>
                </table>
                <![endif]-->
            </td>
        </tr>
    </table>

    <!-- CTA Button -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 32px 0;">
        <tr>
            <td align="center">
                <!--[if mso]>
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="@Model.ConfirmationUrl" style="height:52px;v-text-anchor:middle;width:220px;" arcsize="50%" stroke="false">
                <v:fill type="gradient" color="#ff6b6b" color2="#e94560" angle="135"/>
                <w:anchorlock/>
                <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">Verify Email Address</center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><!-->
                <a href="@Model.ConfirmationUrl" target="_blank" style="display: inline-block; background: linear-gradient(135deg, #e94560 0%, #ff6b6b 100%); color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 16px; font-weight: 600; text-decoration: none; padding: 16px 40px; border-radius: 50px; letter-spacing: 0.5px; box-shadow: 0 4px 16px rgba(233,69,96,0.3);">Verify Email Address</a>
                <!--<![endif]-->
            </td>
        </tr>
    </table>

    <!-- Fallback Link -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding-top: 16px; font-family: Arial, sans-serif; font-size: 13px; color: #718096; line-height: 1.6;">
                If the button doesn't work, <a href="@Model.ConfirmationUrl" style="color: #e94560; text-decoration: underline;">click here to verify</a>
            </td>
        </tr>
    </table>
}
else
{
    <!-- Highlight Box - Get Started -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 24px 0;">
        <tr>
            <td width="4" style="background-color: #10b981;"></td>
            <td style="background: linear-gradient(135deg, #f8f9fa 0%, #eef1f5 100%); padding: 24px 28px;">
                <!--[if mso]>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" bgcolor="#f8f9fa">
                <tr>
                <td style="padding: 24px 28px;">
                <![endif]-->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="font-family: Arial, sans-serif; font-size: 12px; font-weight: bold; color: #10b981; letter-spacing: 2px; text-transform: uppercase; padding-bottom: 12px;">
                            Get Started
                        </td>
                    </tr>
                    <tr>
                        <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #2d3748;">
                            Your account is ready! Log in now to explore all the features and start your journey with us.
                        </td>
                    </tr>
                </table>
                <!--[if mso]>
                </td>
                </tr>
                </table>
                <![endif]-->
            </td>
        </tr>
    </table>

    @if (!string.IsNullOrEmpty(Model.LoginUrl))
    {
        <!-- CTA Button -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 32px 0;">
            <tr>
                <td align="center">
                    <!--[if mso]>
                    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="@Model.LoginUrl" style="height:52px;v-text-anchor:middle;width:180px;" arcsize="50%" stroke="false">
                    <v:fill type="gradient" color="#34d399" color2="#10b981" angle="135"/>
                    <w:anchorlock/>
                    <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">Log In Now</center>
                    </v:roundrect>
                    <![endif]-->
                    <!--[if !mso]><!-->
                    <a href="@Model.LoginUrl" target="_blank" style="display: inline-block; background: linear-gradient(135deg, #10b981 0%, #34d399 100%); color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 16px; font-weight: 600; text-decoration: none; padding: 16px 40px; border-radius: 50px; letter-spacing: 0.5px; box-shadow: 0 4px 16px rgba(16,185,129,0.3);">Log In Now</a>
                    <!--<![endif]-->
                </td>
            </tr>
        </table>
    }
}


<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 32px 0;">
    <tr>
        <td style="height: 1px; background: linear-gradient(90deg, transparent 0%, #e2e8f0 50%, transparent 100%); font-size: 1px; line-height: 1px;">
            &nbsp;
        </td>
    </tr>
</table>

<!-- Small Text -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td style="font-family: Arial, sans-serif; font-size: 12px; color: #999999; line-height: 1.6;">
            If you didn't create this account, please ignore this email or contact our support team.
        </td>
    </tr>
</table>
