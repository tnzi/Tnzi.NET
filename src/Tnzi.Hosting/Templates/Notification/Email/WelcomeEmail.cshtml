---
subject: Your account is ready
layout: DefaultEmail
description: Welcome email template for new user registration
metadata:
  type: Email
  version: "5.0"
---
@{
    var needsConfirmation = Model.RequireEmailConfirmation == true && !string.IsNullOrEmpty(Model.ConfirmationUrl);
}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td class="greeting ink" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 22px; font-weight: 600; color: #1a1a2e; line-height: 1.35; padding-bottom: 14px;">
            Welcome, @(Model.UserName ?? "there")
        </td>
    </tr>
    <tr>
        <td class="ink-soft" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif; font-size: 16px; line-height: 1.65; color: #4a5568;">
            @if (needsConfirmation)
            {
                <text>Your account is created. Confirm your email address to activate it.</text>
            }
            else
            {
                <text>Your account is ready to use.</text>
            }
        </td>
    </tr>
</table>

@if (needsConfirmation)
{
    <!-- CTA -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" class="btn" style="margin: 26px 0 0 0;">
        <tr>
            <td bgcolor="#0f3460" style="border-radius: 8px;">
                <!--[if mso]>
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="@Model.ConfirmationUrl" style="height:48px;v-text-anchor:middle;width:200px;" arcsize="16%" fillcolor="#0f3460" stroke="false">
                <w:anchorlock/>
                <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">Confirm email address</center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><!-->
                <a href="@Model.ConfirmationUrl" target="_blank" style="display: inline-block; padding: 14px 28px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px; background-color: #0f3460; text-align: center;">Confirm email address</a>
                <!--<![endif]-->
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 22px;">
        <tr>
            <td class="ink-faint" style="font-family: Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #8b929b;">
                Or paste this into your browser:<br>
                <a href="@Model.ConfirmationUrl" style="color: #6b7280; text-decoration: underline; word-break: break-all;">@Model.ConfirmationUrl</a>
            </td>
        </tr>
    </table>
}
else if (!string.IsNullOrEmpty(Model.LoginUrl))
{
    <!-- CTA -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" class="btn" style="margin: 26px 0 0 0;">
        <tr>
            <td bgcolor="#0f3460" style="border-radius: 8px;">
                <!--[if mso]>
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="@Model.LoginUrl" style="height:48px;v-text-anchor:middle;width:150px;" arcsize="16%" fillcolor="#0f3460" stroke="false">
                <w:anchorlock/>
                <center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">Log in</center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><!-->
                <a href="@Model.LoginUrl" target="_blank" style="display: inline-block; padding: 14px 32px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px; background-color: #0f3460; text-align: center;">Log in</a>
                <!--<![endif]-->
            </td>
        </tr>
    </table>
}

<!-- Reassurance -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 22px;">
    <tr>
        <td class="ink-faint" style="font-family: Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #8b929b;">
            Didn't create this account? Ignore this email.
        </td>
    </tr>
</table>
