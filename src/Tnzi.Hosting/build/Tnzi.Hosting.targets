<Project>
  <!--
    TnziModules-driven optional dependency injection.
    Consumer sets <TnziModules>Identity;Storage;...</TnziModules> in their csproj,
    and matching Tnzi.* packages are automatically referenced.

    The match is a substring check, so a sub-module token also pulls in its parent
    (e.g. "Finance.Payroll" matches both Finance and Finance.Payroll - which is what
    the sub-module needs anyway). Keep this list in sync with the [OptionalDependsOn]
    list on HostingModule: a module declared there but missing here is silently not
    referenced for package consumers.
  -->

  <ItemGroup Condition="$(TnziModules.Contains('Identity'))">
    <PackageReference Include="Tnzi.Identity" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Authorization'))">
    <PackageReference Include="Tnzi.Authorization" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Storage'))">
    <PackageReference Include="Tnzi.Storage" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Template'))">
    <PackageReference Include="Tnzi.Template" Version="$(TnziVersion)" />
  </ItemGroup>

  <!--
    'Documents' is a substring of 'Finance.Documents', so strip that token before matching -
    otherwise asking for the finance cheque renderer would silently drag in the PDF primitives too.
  -->
  <ItemGroup Condition="$(TnziModules.Replace('Finance.Documents', '').Contains('Documents'))">
    <PackageReference Include="Tnzi.Documents" Version="$(TnziVersion)" />
  </ItemGroup>

  <!--
    Signing was promoted out of Documents (the judgement is归属 not 依赖: it owns a Signing_
    prefix while Documents owns no table), so the package is Tnzi.Signing, not
    Tnzi.Documents.Signing. Asking for it SHOULD also bring in Tnzi.Documents, which it
    [DependsOn] - the condition above does not do that any more now that the token no longer
    contains 'Documents', so this block pulls both.
  -->
  <ItemGroup Condition="$(TnziModules.Contains('Signing'))">
    <PackageReference Include="Tnzi.Signing" Version="$(TnziVersion)" />
    <PackageReference Include="Tnzi.Documents" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Notification'))">
    <PackageReference Include="Tnzi.Notification" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('System'))">
    <PackageReference Include="Tnzi.System" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Audit'))">
    <PackageReference Include="Tnzi.Audit" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Chat'))">
    <PackageReference Include="Tnzi.Chat" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('AI'))">
    <PackageReference Include="Tnzi.AI" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Feature'))">
    <PackageReference Include="Tnzi.Feature" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Hangfire'))">
    <PackageReference Include="Tnzi.Hangfire" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('SignalR'))">
    <PackageReference Include="Tnzi.SignalR" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Identity.Presence'))">
    <PackageReference Include="Tnzi.Identity.Presence" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('AI.Skills'))">
    <PackageReference Include="Tnzi.AI.Skills" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('AI.Workflow'))">
    <PackageReference Include="Tnzi.AI.Workflow" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('AI.Mcp'))">
    <PackageReference Include="Tnzi.AI.Mcp" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('AI.Rag'))">
    <PackageReference Include="Tnzi.AI.Rag" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('AI.Sandbox'))">
    <PackageReference Include="Tnzi.AI.Sandbox" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('AI.Channels'))">
    <PackageReference Include="Tnzi.AI.Channels" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Payment'))">
    <PackageReference Include="Tnzi.Payment" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Finance'))">
    <PackageReference Include="Tnzi.Finance" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Finance.Ai'))">
    <PackageReference Include="Tnzi.Finance.Ai" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Finance.Banking'))">
    <PackageReference Include="Tnzi.Finance.Banking" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Finance.Documents'))">
    <PackageReference Include="Tnzi.Finance.Documents" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Finance.Recurring'))">
    <PackageReference Include="Tnzi.Finance.Recurring" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Finance.Tax.Ca'))">
    <PackageReference Include="Tnzi.Finance.Tax.Ca" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Finance.Payroll'))">
    <PackageReference Include="Tnzi.Finance.Payroll" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Finance.Offers'))">
    <PackageReference Include="Tnzi.Finance.Offers" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Identity.Organization'))">
    <PackageReference Include="Tnzi.Identity.Organization" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Authorization.DataAuth'))">
    <PackageReference Include="Tnzi.Authorization.DataAuth" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Storage.Workspace'))">
    <PackageReference Include="Tnzi.Storage.Workspace" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Storage.Cloud'))">
    <PackageReference Include="Tnzi.Storage.Cloud" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Notification.Push'))">
    <PackageReference Include="Tnzi.Notification.Push" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Payment.Billing'))">
    <PackageReference Include="Tnzi.Payment.Billing" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Payment.Subscriptions'))">
    <PackageReference Include="Tnzi.Payment.Subscriptions" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Payment.Promotions'))">
    <PackageReference Include="Tnzi.Payment.Promotions" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Payment.Stripe'))">
    <PackageReference Include="Tnzi.Payment.Stripe" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('Payment.PayPal'))">
    <PackageReference Include="Tnzi.Payment.PayPal" Version="$(TnziVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TnziModules.Contains('AI.Cli'))">
    <PackageReference Include="Tnzi.AI.Cli" Version="$(TnziVersion)" />
  </ItemGroup>

</Project>
