<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Operation audit trail module for Tnzi.NET framework with automatic action logging and change tracking</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 后台服务的单轮驱动等纯内部协作成员为 internal，仅对本模块的测试项目开放。 -->
    <InternalsVisibleTo Include="Tnzi.Audit.Tests, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
  </ItemGroup>

</Project>
