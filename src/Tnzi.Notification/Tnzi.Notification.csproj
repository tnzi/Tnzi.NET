<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Multi-channel notification module for Tnzi.NET framework with email, SMS, and push notification support using template rendering</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.Template\Tnzi.Template.csproj" />
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tnzi.Notification.Tests, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="FirebaseAdmin" Version="3.5.0" />
    <!-- Twilio and Plivo SDK removed - using HTTP REST API instead -->
    <!-- Microsoft.EntityFrameworkCore is provided by Tnzi.EFCore project reference -->
  </ItemGroup>

</Project>
