<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Skill management module for Tnzi.NET AI - skill registry, search, template engine, constraint enforcement</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.AI\Tnzi.AI.csproj" />
  </ItemGroup>

  <!-- 内置技能 — 所有文件嵌入程序集，LogicalName 保留原始相对路径 -->
  <ItemGroup>
    <EmbeddedResource Include="Skills\BuiltIn\**\*" Exclude="Skills\BuiltIn\**\*.cs">
      <LogicalName>BuiltInSkill:%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
