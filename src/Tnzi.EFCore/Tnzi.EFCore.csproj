<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Entity Framework Core integration for Tnzi.NET framework with multi-database support, repository pattern, unit of work, automatic ID generation, and data filtering</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi\Tnzi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- 安全提升 System.Security.Cryptography.Pkcs：SqlClient 没有 net10.0 依赖组，.NET 10 落到它的 net9.0 组，
         解析出 9.0.x 线（GHSA-2fmv-rv2c-59x7 / GHSA-846f-f764-76mx，修复版 9.0.21 / 10.0.13）。
         EFCore 是这条链的共同底座：下游工程经它拿到 10.0.13，同级的 MimeKit（要求 >= 10.0.0）也一并被抬上来。
         SqlClient 自己的依赖组跟上修复版之后可以删掉这一行。 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- 统一 IdentityModel 版本：SqlClient 只要求 >= 8.16.0 并解析到 8.16.0，而 Tnzi.Identity 钉了 8.19.1。
         EFCore 是这条链的共同底座，在此提升可让所有下游拿到同一版本，否则同时看到两个程序集版本的项目
         （如 tests/Tnzi.Tests：经 Tnzi.Hosting 拿到 Tnzi.Identity.dll，但 NuGet 图里没有 Identity 的提升）
         会报 MSB3277 冲突且无法解析。 -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <!-- 统一 System.ClientModel 版本：Tnzi.Storage.Cloud 经 Azure.Storage.Blobs → Azure.Core 只要求 >= 1.14.0，
         而 Tnzi.AI 经 Microsoft.Extensions.AI.OpenAI → OpenAI 要求 >= 1.15.0。
         同时引用两者的工程（Tnzi.Hosting）NuGet 会自己统一，所以框架自身的构建看不到问题；
         但 Tnzi.Storage.Cloud.dll 是对着较低版本编译的，它的程序集引用就写着那个版本，
         于是任何把两条链的产物放进同一输出目录的消费应用都会报 MSB3277，
         "chosen because it was primary"，而那是一个潜伏的 MissingMethodException。
         在共同底座提升，让所有下游工程对着同一版本编译（与上面 IdentityModel 同一手法）。
         ★ 钉 OpenAI 编译时用的那一版，不要钉 System.ClientModel 的最新版：1.16 把实验类型
         AsyncStreamingClientResult 改名为 AsyncStreamingResult，而 OpenAI 2.14 是对着 1.15 编译的，
         它引用旧类型名的公开方法（Audio / Image 的流式重载）在 1.16 下 JIT 时抛 TypeLoadException。
         OpenAI 换到对着更新版本编译的发行之后再跟着提。 -->
    <PackageReference Include="System.ClientModel" Version="1.15.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- PublicApiAnalyzers API 门禁（0.1.0 冻结基线）。未登记的公共 API => RS0016 error；
       删除死条目 => RS0017 error。RS0026/RS0027（可选参数重载设计建议）保持 warning。
       基线见同目录 PublicAPI.Shipped.txt；增删改 API 的登记工作流见 docs/coding-standards/public-api-governance.md。 -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0024;RS0025</WarningsAsErrors>
  </PropertyGroup>

</Project>
