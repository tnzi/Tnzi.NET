<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Entity Framework Core integration for Tnzi.NET framework with multi-database support, repository pattern, unit of work, automatic ID generation, and data filtering</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi\Tnzi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- 统一 IdentityModel 版本：SqlClient 只要求 >= 8.16.0 并解析到 8.16.0，而 Tnzi.Identity 钉了 8.19.1。
         EFCore 是这条链的共同底座，在此提升可让所有下游拿到同一版本，否则同时看到两个程序集版本的项目
         （如 tests/Tnzi.Tests：经 Tnzi.Hosting 拿到 Tnzi.Identity.dll，但 NuGet 图里没有 Identity 的提升）
         会报 MSB3277 冲突且无法解析。 -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- PublicApiAnalyzers API 门禁（0.1.0 冻结基线）。未登记的公共 API => RS0016 error；
       删除死条目 => RS0017 error。RS0026/RS0027（可选参数重载设计建议）保持 warning。
       基线见同目录 PublicAPI.Shipped.txt；增删改 API 的登记工作流见 docs/coding-standards/public-api-governance.md。 -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0024;RS0025</WarningsAsErrors>
  </PropertyGroup>

</Project>
