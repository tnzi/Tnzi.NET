<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>AI/ML integration module for Tnzi.NET framework with chat clients, RAG, MCP protocol, tool scanning, and quota management</Description>
    <!-- 抑制 Microsoft.Extensions.AI 实验性 API 警告 -->
    <NoWarn>$(NoWarn);MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <PackageReference Include="Anthropic" Version="12.35.1" />
    <!-- Resilience -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <!-- MCP (Model Context Protocol) - official C# SDK for connecting to MCP servers -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <!-- YAML parsing for agent definition files -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- T-SQL AST parser for AI SQL tools (validator hardening) -->
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.37.3" />
    <!-- Readability: HTML article extraction（0.11.1 起要求 AngleSharp >= 1.5.2，含 mXSS 修复 GHSA-pgww-w46g-26qg） -->
    <PackageReference Include="SmartReader" Version="0.11.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.EFCore\Tnzi.EFCore.csproj" />
    <ProjectReference Include="..\Tnzi.AspNetCore\Tnzi.AspNetCore.csproj" />
    <ProjectReference Include="..\Tnzi\Tnzi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tnzi.AI.Tests, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

</Project>
