---
subject: "Action required: your subscription payment failed"
layout: DefaultEmail
description: Sent to the billing contacts when a renewal or trial-conversion charge fails and the grace period starts or continues
metadata:
  type: Email
  version: "1.0"
---
@{
    var manageUrl = (string?)Model.ManageUrl;
    var hasLink = !string.IsNullOrWhiteSpace(manageUrl);
    var paymentMethod = (string?)Model.PaymentMethod;
}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td class="greeting ink" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 22px; font-weight: 600; color: #1a1a2e; line-height: 1.35; padding-bottom: 14px;">
            We couldn't renew your @Model.PlanName
        </td>
    </tr>
    <tr>
        <td class="ink-soft" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 16px; line-height: 1.65; color: #4a5568;">
            Hi @(string.IsNullOrWhiteSpace((string?)Model.CustomerName) ? "there" : Model.CustomerName),
            the payment for subscription @Model.SubscriptionNo did not go through because @Model.Reason@(string.IsNullOrWhiteSpace(paymentMethod) ? "" : $" ({paymentMethod})").
            Please pay or update the payment method before <strong>@Model.Deadline</strong>.
            @if (Model.SuspendsService == true)
            {
                <text>After that date service is suspended until the outstanding amount is paid.</text>
            }
            else
            {
                <text>After that date the subscription expires.</text>
            }
        </td>
    </tr>
    <tr>
        <td class="ink-faint" style="font-family: Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #8b929b; padding-top: 10px;">
            Attempt @Model.Attempt of @Model.MaxAttempts. We will retry automatically during the grace period.
        </td>
    </tr>
</table>

@if (hasLink)
{
<table role="presentation" cellspacing="0" cellpadding="0" border="0" class="btn" style="margin: 26px 0 0 0;">
    <tr>
        <td bgcolor="#0f3460" style="border-radius: 8px;">
            <a href="@manageUrl" target="_blank" style="display: inline-block; padding: 14px 28px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px; background-color: #0f3460; text-align: center;">Update payment</a>
        </td>
    </tr>
</table>
}
