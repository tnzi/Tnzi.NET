<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Payroll sub-module for the Tnzi.NET finance module: employee master data, salary components with a safe formula engine, tax bracket tables, salary structures and assignments</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.Finance\Tnzi.Finance.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NCalc" Version="7.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试要读 internal 的列宽常量（PayslipFieldLimits）：SQLite 不检查 varchar 宽度，
         「装得进 1000 字符的列」只能靠长度断言看见，而那个数字必须与实体配置同源。 -->
    <InternalsVisibleTo Include="Tnzi.Finance.Payroll.Tests, PublicKey=$(TnziPublicKey)" />
  </ItemGroup>

</Project>
