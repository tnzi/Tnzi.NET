<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Firebase Cloud Messaging push channel for the Tnzi.NET notification module. Load it only when the application actually delivers push notifications; without it Tnzi.Notification carries no FirebaseAdmin dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.Notification\Tnzi.Notification.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
  </ItemGroup>

</Project>
