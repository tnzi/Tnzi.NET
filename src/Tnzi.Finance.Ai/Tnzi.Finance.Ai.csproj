<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>AI-backed implementations for the Tnzi.NET finance module: vision + structured-output receipt/invoice field extraction (default IReceiptExtractor). Optional module; load it to make finance receipt capture work out of the box.</Description>
    <!-- Microsoft.Extensions.AI DataContent / structured output are experimental (MEAI001);
         consumed by the vision-based receipt extractor. -->
    <NoWarn>$(NoWarn);MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tnzi.Finance\Tnzi.Finance.csproj" />
    <!-- IReceiptExtractor 契约随银行域走（收据采集属银行域摄取） -->
    <ProjectReference Include="..\Tnzi.Finance.Banking\Tnzi.Finance.Banking.csproj" />
    <ProjectReference Include="..\Tnzi.AI\Tnzi.AI.csproj" />
    <ProjectReference Include="..\Tnzi.Storage\Tnzi.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      PDF 收据走文本路径（AiReceiptExtractor 用 PdfPig 读文字，再交给 LLM 结构化）。
      2026-08-07 之前这是从 Tnzi.AI 传递来的：本项目用着 UglyToad 却没声明过它。
      AI 那边的文档转换器删除后传递链断了 —— 直接依赖就该直接声明。
      版本对齐 Tnzi.Documents / Tnzi.AI.Rag。
    -->
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

</Project>
