<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Authors>Tnzi</Authors>
    <Company>Tnzi</Company>
    <Copyright>Copyright (c) 2014-2026 Tnzi. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tnzi/Tnzi.NET</PackageProjectUrl>
    <PackageReleaseNotes></PackageReleaseNotes>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/tnzi/Tnzi.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Tnzi</PackageTags>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Tnzi.snk</AssemblyOriginatorKeyFile>
    <!-- Tnzi.snk 公钥投影(sn -p + sn -tp 提取)。InternalsVisibleTo 声明统一引用
         $(TnziPublicKey),密钥轮换只改这一处;friend 测试项目须以同一 snk 签名。 -->
    <TnziPublicKey></TnziPublicKey>
    <!-- 必须为 true：①发布的 NuGet 包带 XML 文档，消费者才有 IntelliSense；
         ②IDE0005（多余 using）只有在生成 XML 文档时才会在 build 阶段报出（dotnet/roslyn#41640），
         设为 false 会让根 Directory.Build.props 的 EnforceCodeStyleInBuild 对 using 清理静默失效。
         本文件经 src/Directory.Build.props 在根 props **之后**导入，故这里的值是 src 下的最终值。
         CS1591（公共成员缺注释）已在下方 NoWarn 抑制。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- 1701, 1702: 程序集版本警告，不影响功能 -->
    <!-- 1591: XML 文档注释警告，保留抑制 -->
    <!-- 8002: 其他警告，保留抑制 -->
    <NoWarn>$(NoWarn);1701;1702;1591;8002</NoWarn>
  </PropertyGroup>
 
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" Visible="false" PackagePath=""/>
  </ItemGroup>
</Project>
