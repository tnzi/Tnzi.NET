<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 共享测试基础库，不含测试用例，跳过 dotnet test -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- 提升传递依赖：EFCore.Sqlite 带来的 bundle 2.1.11 内含有漏洞的 SQLite 原生库（GHSA-2m69-gcr7-jv3q） -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tnzi\Tnzi.csproj" />
  </ItemGroup>

  <!--
    仓库根的编译期真值，供 RepoRoot.Locate() 使用。

    为什么不靠运行时从 AppContext.BaseDirectory 向上找：那条路径依赖测试产物落在仓库树内，
    而 -p:BaseOutputPath=<临时目录>/（本仓库验证手册用来绕开 MSB3021 文件锁的推荐做法）
    会把产物挪出仓库，于是 12 个源码扫描门禁全部静默通过。编译期路径没有这个耦合。
  -->
  <ItemGroup>
    <AssemblyMetadata Include="TnziRepoRoot" Value="$(MSBuildThisFileDirectory)..\.." />
  </ItemGroup>

</Project>

