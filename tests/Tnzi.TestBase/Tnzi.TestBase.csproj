<Project Sdk="Microsoft.NET.Sdk">

  <!--
    发布出去的测试底座。

    ★ 它住在 tests/ 而不是 src/，同时又是一个 NuGet 包 —— 两件事都是有意的。
    src/ 被四套机制赋予了确定语义（版本线与强签名 / modules-index 对账 / 公开镜像投影 /
    打包脚本递归扫描），本项目只满足其中两条：它该跟着框架的版本线走、该被打包，
    但它不是模块、不该进 modules-index。搬进 src/ 只为拿到打包，代价是 46 个测试项目
    改引用路径外加一条门禁排除，而收益与「住在哪」无关。

    所以版本线与包元数据在这里显式导入，打包由 build/nuget-pack.ps1 点名（那个脚本只递归扫 src/）。
  -->
  <Import Project="..\..\build\version.props" />
  <Import Project="..\..\build\public.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Test harness for applications built on the Tnzi.NET framework: an integration-test base over an in-memory SQLite DbContext with the framework's ambient services mocked, plus module-graph and reflection helpers.</Description>
    <PackageTags>Tnzi;testing;xunit;integration-test</PackageTags>
    <!-- 不是模块，官网没有它的模块页；生成的 README 改链到公开镜像里的源码目录（tests/ 在投影允许列表内）。 -->
    <TnziDocsUrl>https://github.com/tnzi/Tnzi.NET/tree/main/tests/Tnzi.TestBase</TnziDocsUrl>
    <!-- 共享测试基础库，不含测试用例，跳过 dotnet test -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- 提升传递依赖：EFCore.Sqlite 带来的 bundle 2.1.11 内含有漏洞的 SQLite 原生库（GHSA-2m69-gcr7-jv3q） -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tnzi\Tnzi.csproj" />
  </ItemGroup>

  <!--
    仓库根的编译期真值，供 RepoRoot.Locate() 使用。

    为什么不靠运行时从 AppContext.BaseDirectory 向上找：那条路径依赖测试产物落在仓库树内，
    而 -p:BaseOutputPath=<临时目录>/（本仓库验证手册用来绕开 MSB3021 文件锁的推荐做法）
    会把产物挪出仓库，于是 12 个源码扫描门禁全部静默通过。编译期路径没有这个耦合。
  -->
  <ItemGroup>
    <AssemblyMetadata Include="TnziRepoRoot" Value="$(MSBuildThisFileDirectory)..\.." />
  </ItemGroup>

</Project>

